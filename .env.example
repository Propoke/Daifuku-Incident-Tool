# Copy to .env and fill in real values. Never commit the real .env.

# --- Django ---
DJANGO_SECRET_KEY=changeme-generate-a-real-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=cmms.internal.local,localhost

# --- Postgres ---
POSTGRES_DB=cmms
POSTGRES_USER=cmms
POSTGRES_PASSWORD=changeme

# --- Redis (Celery broker/result backend - PM auto-ticketing) ---
REDIS_URL=redis://redis:6379/0

# --- Traefik routing ---
# Real hostname on your DNS (internal-resolving is fine - DNS-01 doesn't
# require this host to be internet-reachable). Point ${CMMS_HOSTNAME} at a
# zone managed in Cloudflare so the ACME DNS challenge below can complete.
CMMS_HOSTNAME=cmms.internal.yourcompany.com

# --- TLS: Let's Encrypt via Cloudflare DNS-01 (see docs/infrastructure-setup-plan.md) ---
# Real address - Let's Encrypt uses this for expiry/problem notices.
ACME_EMAIL=ops@yourcompany.com
# Cloudflare API token scoped to Zone:DNS:Edit for the zone above (not the global API key).
CF_DNS_API_TOKEN=your-cloudflare-scoped-api-token
# Defaults to Let's Encrypt production. For testing, use the staging server to
# avoid rate limits: https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# --- Entra ID (Azure AD) OIDC app registration ---
OIDC_TENANT_ID=your-entra-tenant-id
OIDC_RP_CLIENT_ID=your-app-registration-client-id
OIDC_RP_CLIENT_SECRET=your-app-registration-client-secret
