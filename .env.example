# Copy to .env and fill in real values. Never commit the real .env.

# --- Django ---
DJANGO_SECRET_KEY=changeme-generate-a-real-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=cmms.internal.local,localhost

# --- Postgres ---
POSTGRES_DB=cmms
POSTGRES_USER=cmms
POSTGRES_PASSWORD=changeme

# --- Traefik routing ---
CMMS_HOSTNAME=cmms.internal.local

# --- Entra ID (Azure AD) OIDC app registration ---
OIDC_TENANT_ID=your-entra-tenant-id
OIDC_RP_CLIENT_ID=your-app-registration-client-id
OIDC_RP_CLIENT_SECRET=your-app-registration-client-secret
